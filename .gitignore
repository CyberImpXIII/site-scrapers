node_modules/
*.log

# handoff capture files -- may contain secrets typed during a handoff step
# (passwords, one-time codes). Temporary; never committed.
data/.captures/

# session cookie jars -- persisted login/session state per (hostname,
# sessionName). Never committed.
data/.sessions/

# the recipe DB itself -- was tracked in earlier commits (still present in
# git history), untracked going forward so job-search queries/URLs and
# recipe content stop accumulating in a public commit history. Each
# environment keeps/builds its own local copy; openDb() creates it fresh if
# missing.
data/scrapers.db
# SQLite WAL sidecars (present while a run is in flight, and left behind if
# a process dies mid-run).
data/scrapers.db-wal
data/scrapers.db-shm

# failure-diagnostics captures (screenshot/DOM/console/network) -- may
# contain page content from whatever a recipe was looking at when it
# failed. Disposable debugging data, not an audit trail; never committed.
data/.debug/

# opt-in fill screenshots (params.fillScreenshot, lib/fillScreenshot.js) --
# an image of a filled application form, i.e. of Jacob's answers. Never
# committed; test/fill-screenshot.test.js checks this line holds.
data/.fills/

# troubleshooting knowledge base -- accumulates hostnames, selectors and
# error text from real runs. Same reasoning as scrapers.db: the TAXONOMY
# lives in lib/failureTypes.js (version-controlled), the observations do not.
data/failures.db
data/failures.db-wal
data/failures.db-shm
.check.lock

# tools/setup's proposal for settings.json (written by `setup ... --only hooks`).
# Applying it is Jacob's step, never an agent's; it is regenerated on every run.
# Same line as tools/hooks and addon-bench.
.claude/settings.proposed.json

# environment files -- may hold credentials; credential-shaped values are
# supplied at run time, never stored (CLAUDE.md "Constraints that don't
# bend"). An example/sample/template file carries key names only and is
# committed. Checked by tools/checks `no-secrets` and test/gitignore-env.test.js.
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
